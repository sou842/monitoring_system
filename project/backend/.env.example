# Copy to .env.local for local development; set the same variables in Vercel.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/monitor?retryWrites=true&w=majority
MONGODB_DB=monitor

CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_UPLOAD_PRESET=<unsigned-upload-preset>

# Dashboard login (shared password) and a long random string that signs login cookies.
DASHBOARD_PASSWORD=<choose-a-password>
SESSION_SECRET=<64-random-hex-characters>
