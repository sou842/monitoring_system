# Copy to .env.local for local development; set the same variables in Vercel.

# --- Server ---------------------------------------------------------------
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/monitor?retryWrites=true&w=majority
MONGODB_DB=monitor
# Long random string that signs login cookies. Changing it logs everyone out.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=<64-random-hex-characters>

# --- The app monitoring itself (optional) ----------------------------------
# Create a project in the dashboard and put its key here: the dashboard and the
# SDK demo pages (/demo) then report their own errors to it.
NEXT_PUBLIC_ET_API_KEY=<project API key from the dashboard>
# Leave both unset to report to this app itself (/api/v1/events). Set them to
# send somewhere else, e.g. local development reporting to production.
# NEXT_PUBLIC_ET_ENDPOINT=https://monitoringsystem-backend.vercel.app/api/v1/events
# ET_SERVER_ENDPOINT=https://monitoringsystem-backend.vercel.app/api/v1/events
