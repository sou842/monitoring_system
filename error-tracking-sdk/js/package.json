{
  "name": "@sourav732/error-tracker-js",
  "version": "0.10.0",
  "description": "Lightweight, zero-dependency error, performance and crash tracking SDK for browser apps (React, Vue, Next.js, vanilla JS).",
  "keywords": [
    "error-tracking",
    "error-monitoring",
    "crash-reporting",
    "performance-monitoring",
    "web-vitals",
    "browser",
    "react",
    "nextjs",
    "vue"
  ],
  "author": "sourav",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sou842/monitoring_system.git",
    "directory": "error-tracking-sdk/js"
  },
  "homepage": "https://monitoringsystem-backend.vercel.app/",
  "bugs": {
    "url": "https://github.com/sou842/monitoring_system/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=14"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && rollup -c && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "jsdom": "^30.1.3",
    "rollup": "^4.64.8",
    "tslib": "^2.8.1",
    "typescript": "~5.9",
    "vitest": "^5.0.5"
  }
}
