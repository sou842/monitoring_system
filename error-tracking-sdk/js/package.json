{
  "name": "@company/error-tracker-js",
  "version": "1.0.0",
  "description": "Client-side error, performance and crash tracking SDK for browser apps.",
  "license": "UNLICENSED",
  "private": true,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=14"
  },
  "scripts": {
    "build": "rollup -c && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.0",
    "jsdom": "^30.1.3",
    "rollup": "^4.64.8",
    "tslib": "^2.8.1",
    "typescript": "~5.9",
    "vitest": "^5.0.5"
  }
}
